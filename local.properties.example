# Copy this file to local.properties for local Android Studio builds.
# Keep your SDK path and add your own keys; never commit local.properties.
sdk.dir=C\\:\\Users\\YOUR_USER\\AppData\\Local\\Android\\Sdk
ORS_API_KEY=
CARTO_API_KEY=
GOOGLE_STREETVIEW_API_KEY=
MAPILLARY_ACCESS_TOKEN=

# Either Google key name is accepted by the build.
GOOGLE_MAPS_API_KEY=
