<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HAULWAYNavigation" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#159BFA</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#030A12</item>
        <item name="android:navigationBarColor">#030A12</item>
        <!-- Full HAULWAY artwork is visible behind the Activity while Compose starts. -->
        <item name="android:windowBackground">@drawable/haulway_starting_window</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.HAULWAYNavigation.Starting" parent="Theme.HAULWAYNavigation">
        <item name="android:windowBackground">@drawable/haulway_starting_window</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
